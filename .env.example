# Every key and token MonoPlus uses goes here, in backend/.env (copy this file there). The web app never
# asks for, sends or stores a key. Check them with: .venv\Scripts\python -m app.connections check
# ---------------------------------------------------------------------------
# AI: NVIDIA Nemotron on Nebius Token Factory (OpenAI-compatible).
# Without a key, MonoPlus still runs (template copy, rule-based humanizer).
# Wrong model ids are corrected automatically to the closest Nemotron your key can use.
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_ULTRA=nvidia/NVIDIA-Nemotron-3-Ultra
MODEL_NANO=nvidia/NVIDIA-Nemotron-Nano-9B-v2
# Hard cap on model use per day (tokens), so free credits are never overspent; templates take over when it's reached.
LLM_DAILY_TOKENS=200000
# Optional: also stop at a dollar amount a day. Copy each tier's price from the Token Factory pricing page
# (dollars per million tokens); leave the prices at 0 and this cap stays off.
LLM_DAILY_DOLLARS=0
PRICE_PER_M_ULTRA=0
PRICE_PER_M_NANO=0

# Optional alternative provider: Amazon Bedrock (Converse API). Leave at 0 to use Nebius.
AWS_BEDROCK_ENABLED=0
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ULTRA=amazon.nova-pro-v1:0
AWS_BEDROCK_MODEL_NANO=amazon.nova-lite-v1:0

# ---------------------------------------------------------------------------
# Web search. Without Tavily, free Google News + DuckDuckGo are used automatically.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
FREE_SEARCH=1

# ---------------------------------------------------------------------------
# UGC video ads (both optional: the 3D camera and the free voices need no key)
# ---------------------------------------------------------------------------
# A free Hugging Face "Read" token, for AI scenes filmed by AI video (https://huggingface.co/settings/tokens).
HF_TOKEN=
# HeyGen, for realistic presenters (paid; https://app.heygen.com/settings).
HEYGEN_API_KEY=

# Optional: free Pexels key for instant stock photos (https://www.pexels.com/api/).
# Without it, Creative Commons photos come from Openverse (no key, but ~30s per search).
PEXELS_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Required once deployed: every /api call and the /mcp endpoint (as a Bearer token) need this key.
MONOPLUS_ACCESS_KEY=
# Public URLs of the API and the web app (used in image links and MCP responses).
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3000
# Browser origins allowed to call the API and /mcp.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Direct posting (official APIs). Leave blank to use "Open app + Mark as posted" instead.
# ---------------------------------------------------------------------------
# Instagram + Facebook Page: a long-lived Page access token from a Meta app with
# pages_manage_posts, pages_read_engagement, instagram_basic, instagram_content_publish.
# The Instagram account must be a Business/Creator account linked to the Page.
# Easiest: put a user token from the Graph API Explorer in META_USER_TOKEN (and the app's id and secret,
# so the connection lasts), then run: .venv\Scripts\python -m app.connections meta
# It finds your Page and Instagram account and fills in the five lines below it.
META_USER_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
META_PAGE_NAME=
INSTAGRAM_USERNAME=
# LinkedIn: token with w_member_social (personal) or w_organization_social (company page).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:organization:0000000
# X: OAuth 2.0 user token with tweet.write media.write users.read.
X_USER_ACCESS_TOKEN=
# Optional: send posts to a Zapier / Make / n8n webhook for platforms not connected above.
PUBLISH_WEBHOOK_URL=

# Posts written per model call; batches run concurrently.
COPY_BATCH_SIZE=6
